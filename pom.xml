<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.flowwarden.examples</groupId>
    <artifactId>flowwarden-examples-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FlowWarden Examples (Parent)</name>
    <description>
        Public, copy-paste-friendly examples demonstrating each FlowWarden annotation.
        Each sample is a self-contained Spring Boot app exercising one feature
        of flowwarden-stream-core against a real MongoDB change stream.
    </description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.5.10</spring-boot.version>
        <flowwarden.version>1.0.0-rc.4</flowwarden.version>
        <flowwarden-javers.version>1.0.0-rc.2</flowwarden-javers.version>
        <javers.version>7.11.8</javers.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <awaitility.version>4.2.2</awaitility.version>
    </properties>

    <modules>
        <module>examples-common</module>
        <module>imperative</module>
        <module>reactive</module>
    </modules>

    <!-- SNAPSHOTs only: resolves unreleased stream-core snapshots published by
         core CI to GitHub Packages (reads require authentication even for
         public packages — CI uses GITHUB_TOKEN; locally either configure a
         read:packages PAT for server id "github" in ~/.m2/settings.xml or
         `./mvnw install` the core checkout). Releases resolve from Maven
         Central as usual. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/flowwarden-io/flowwarden-stream-core</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-bom</artifactId>
                <version>${flowwarden.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-javers</artifactId>
                <version>${flowwarden-javers.version}</version>
            </dependency>

            <dependency>
                <groupId>org.javers</groupId>
                <artifactId>javers-spring-boot-starter-mongo</artifactId>
                <version>${javers.version}</version>
            </dependency>

            <dependency>
                <groupId>io.flowwarden.examples</groupId>
                <artifactId>examples-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
